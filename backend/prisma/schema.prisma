generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum NovelStatus {
  DRAFT
  ONGOING
  COMPLETED
}

enum ChapterStatus {
  DRAFT
  TRANSLATING
  PARTIAL
  TRANSLATED
  FAILED
  PUBLISHED
}

enum SegmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novels       Novel[]
  aiUsageLogs  AiUsageLog[]

  @@map("users")
}

model Genre {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  novels      NovelGenre[]

  @@map("genres")
}

model Novel {
  id             String       @id @default(uuid())
  title          String
  originalTitle  String?
  author         String?
  description    String?      @db.Text
  coverUrl       String?
  sourceLanguage String       @default("zh")
  targetLanguage String       @default("vi")
  status         NovelStatus  @default(ONGOING)
  uploaderId     String
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  genres         NovelGenre[]
  chapters       Chapter[]

  @@map("novels")
}

model NovelGenre {
  novelId String
  genreId String
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([novelId, genreId])
  @@map("novel_genres")
}

model Chapter {
  id                String        @id @default(uuid())
  novelId           String
  novel             Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapterNumber     Int
  title             String
  originalContent   String        @db.Text
  translatedContent String?       @db.Text
  status            ChapterStatus @default(DRAFT)
  wordCount         Int           @default(0)
  translationStyle  String?
  segments          ChapterSegment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([novelId, chapterNumber])
  @@map("chapters")
}


model ChapterSegment {
  id             String        @id @default(uuid())
  chapterId      String
  chapter        Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  orderIndex     Int
  originalText   String        @db.Text
  translatedText String?       @db.Text
  status         SegmentStatus @default(PENDING)
  errorMessage   String?
  attempts       Int           @default(0)
  needsReview    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([chapterId, orderIndex])
  @@map("chapter_segments")
}

model AiUsageLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String?
  segmentId String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}
